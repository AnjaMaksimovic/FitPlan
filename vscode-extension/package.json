{
  "name": "fitplan",
  "displayName": "FitPlan DSL",
  "description": "Language support for FitPlan DSL — nutrition and training planning",
  "version": "0.1.0",
  "publisher": "fitplan-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:fitplan"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fitplan",
        "aliases": ["FitPlan", "fitplan"],
        "extensions": [".fitplan"],
        "configuration": "./language-configuration/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fitplan",
        "scopeName": "source.fitplan",
        "path": "./syntaxes/fitplan.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "FitPlan DSL",
      "properties": {
        "fitplan.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter for LSP server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}